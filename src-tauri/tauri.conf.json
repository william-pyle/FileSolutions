{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileSolutions",
  "version": "0.3.0",
  "identifier": "app.filesolutions.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FileSolutions",
        "width": 1220,
        "height": 900,
        "minWidth": 780,
        "minHeight": 600,
        "visible": false,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../assets/icons/app.ico"
    ]
  }
}
